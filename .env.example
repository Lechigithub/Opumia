# NAMES ONLY. Never put real values in this file or in any file inside the project.
# Every name below with an empty value is an API key that `pnpm opumia` loads at startup from
# macOS Keychain (service "opumia", account = the name). See "Secrets" in CLAUDE.md.
# Add or change one in macOS Terminal:  security add-generic-password -U -s opumia -a NAME -w
# Check what is available (names only): pnpm opumia keys

# Claude API. Deliberately not ANTHROPIC_API_KEY, so Claude Code never picks it up as its own login.
OPUMIA_ANTHROPIC_KEY=

# Narration
ELEVENLABS_API_KEY=

# Stock and archival media
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
VECTEEZY_API_KEY=
VECTEEZY_ACCOUNT_ID=
VIMEO_ACCESS_TOKEN=
EUROPEANA_API_KEY=
NARA_API_KEY=
WIKIMEDIA_ACCESS_TOKEN=
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_PRIVATE_KEY=
STORYBLOCKS_USER_ID=
STORYBLOCKS_PROJECT_ID=
DATA_GOV_API_KEY=
YOUTUBE_API_KEY=

# Thumbnails ("id:secret")
HIGGSFIELD_API_KEY=

# Cloud (Sprint 5)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
VULTR_API_KEY=

# Other models
KIMI_API_KEY=

# Paths (not secrets; defaults shown)
OPUMIA_LIBRARY_DIR=./Library
OPUMIA_REFERENCE_DIR=./Reference
OPUMIA_DATA_DIR=./data

# Speech recognition (listen-back). Local: whisper-cpp + a model in data/models/. Production: Workers AI Whisper.
OPUMIA_ASR=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Claude spend limit per film in USD (default 3 for films up to 90 s, 6 up to 4 min, else 15)
OPUMIA_MAX_USD=
# ElevenLabs narration model (default eleven_v4)
OPUMIA_TTS_MODEL=
# Set to "off" to master without the room-tone bed
OPUMIA_ROOM_TONE=
